                    "type": "string",
                    "title": "Name",
                    "description": "Name to identify this bus (the trace-event segment for it). Defaults to the channel with '. @ :' replaced by '_'.",
                    "ui:placeholder": "defaults to the channel"
                  }
                }
              },
