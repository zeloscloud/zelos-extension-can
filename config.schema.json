{
  "type": "object",
  "title": "CAN Extension Configuration",
  "description": "Configure one or more CAN buses to monitor in parallel.",
  "ui:options": {
    "autoconfig": "CAN/auto_config"
  },
  "properties": {
    "buses": {
      "type": "array",
      "description": "Add a bus for each CAN adapter on this system, or choose the demo interface for an example.",
      "title": "Buses",
      "minItems": 1,
      "items": {
        "title": "Bus",
        "type": "object",
        "properties": {
          "interface": {
            "type": "string",
            "title": "Interface",
            "description": "CAN interface. SocketCAN is zelos-can's Rust SocketCAN bus (Linux only). macOS/Windows: PCAN, Kvaser, Vector. slcan is a serial-line (LAWICEL) adapter such as a CANable or CANUSB on any OS. gs_usb is a candleLight or CANable (gs_usb firmware) adapter opened over libusb, for macOS and Windows; on Linux the kernel driver makes it a SocketCAN interface, so use SocketCAN there. SocketCAN over SSH works from any OS, bridging a remote SocketCAN interface over SSH using the edge's own can-utils (candump/cansend); nothing is deployed on the edge and TX is always echoed back by the remote kernel loopback.",
            "enum": [
              "SocketCAN",
              "SocketCAN over SSH",
              "PCAN",
              "Kvaser",
              "Vector",
              "slcan (serial)",
              "gs_usb (USB)",
              "Other (python-can)",
              "Demo"
            ]
          },
          "name": {
            "type": "string",
            "title": "Channel Display Name",
            "description": "Label this channel appears under in the trace (its event-name segment). Letters, digits, space, '_' and '-' only. Defaults to Channel, sanitized.",
            "ui:placeholder": "defaults to channel"
          },
          "database_files": {
            "type": "array",
            "title": "Database Files (.dbc)",
            "description": "CAN database files (.dbc, .arxml, .kcd, .sym). Order is precedence: a later file wins a message an earlier one defines differently. Two files naming one message id differently both decode, each into its own table. Leave empty for a raw-frames-only bus.",
            "items": {
              "type": "string",
              "ui:widget": "file-picker"
            },
            "default": [],
            "ui:orderable": true
          },
          "canopen_nodes": {
            "type": "array",
            "title": "CANopen nodes",
            "description": "CANopen devices on this bus, decoded on SocketCAN and SocketCAN over SSH: NMT state, heartbeat, EMCY and SDO, plus the node's PDOs and object names from its EDS or DCF. Leave empty for none.",
            "items": {
              "type": "object",
              "title": "Node",
              "properties": {
                "node_id": {
                  "type": "integer",
                  "title": "Node ID",
                  "description": "1-127. Leave empty for a DCF that sets its NodeID.",
                  "minimum": 1,
                  "maximum": 127
                },
                "file": {
                  "type": "string",
                  "title": "EDS or DCF file",
                  "description": "The node's .eds or .dcf. Without one, the node's protocol messages still decode; its PDOs stay raw frames.",
                  "ui:widget": "file-picker"
                },
                "name": {
                  "type": "string",
                  "title": "Name",
                  "description": "Names the node's events. Letters, digits, space, '_' and '-' only. Defaults to node<id in hex>.",
                  "ui:placeholder": "defaults to node<id>"
                }
              },
              "ui:order": [
                "node_id",
                "file",
                "name"
              ]
            },
            "default": []
          }
        },
        "required": [
          "interface"
        ],
        "dependencies": {
          "interface": {
            "oneOf": [
              {
                "properties": {
                  "interface": {
                    "enum": [
                      "Demo"
                    ]
                  },
                  "canopen_node": {
                    "type": "boolean",
                    "title": "Simulated CANopen node",
                    "description": "Adds a simulated CANopen device to the demo bus: node 0x20, a power distribution unit.",
                    "default": false,
                    "ui:widget": "toggle"
                  }
                }
              },
              {
                "properties": {
                  "interface": {
                    "enum": [
                      "SocketCAN"
                    ]
                  },
                  "channel": {
                    "type": "string",
                    "title": "Channel",
                    "description": "SocketCAN interface name (can0, vcan0, slcan0, ...). Choose from the interfaces on the machine running the agent, or type a name.",
                    "default": "can0",
                    "ui:widget": "action-choices",
                    "ui:options": {
                      "action": "CAN/list_interfaces"
                    }
                  },
                  "fd_mode": {
                    "type": "boolean",
                    "title": "CAN-FD Mode",
                    "description": "Enable CAN-FD for higher data rates and larger payloads",
                    "default": false,
                    "ui:widget": "toggle"
                  },
                  "config_json": {
                    "type": "string",
                    "title": "Advanced Configuration (JSON)",
                    "description": "Additional python-can Bus() kwargs as JSON object"
                  }
                },
                "required": [
                  "channel"
                ],
                "dependencies": {
                  "fd_mode": {
                    "oneOf": [
                      {
                        "properties": {
                          "fd_mode": {
                            "enum": [
                              false
                            ]
                          }
                        }
                      },
                      {
                        "properties": {
                          "fd_mode": {
                            "enum": [
                              true
                            ]
                          },
                          "data_bitrate": {
                            "type": "integer",
                            "title": "CAN-FD Data Bitrate (bps)",
                            "description": "CAN-FD data phase bitrate",
                            "enum": [
                              500000,
                              1000000,
                              2000000,
                              4000000,
                              8000000
                            ],
                            "default": 2000000
                          }
                        },
                        "required": [
                          "data_bitrate"
                        ]
                      }
                    ]
                  }
                }
              },
              {
                "properties": {
                  "interface": {
                    "enum": [
                      "SocketCAN over SSH"
                    ]
                  },
                  "remote_host": {
                    "type": "string",
                    "title": "Remote Host",
                    "description": "Hostname or IP of the edge device running SocketCAN, reached over SSH (may be a ~/.ssh/config alias)"
                  },
                  "remote_channel": {
                    "type": "string",
                    "title": "Remote CAN Channel",
                    "description": "SocketCAN interface name on the remote edge device (e.g. can0, vcan0)",
                    "default": "can0"
                  },
                  "ssh_user": {
                    "type": "string",
                    "title": "SSH User",
                    "description": "Username for the SSH connection (optional; falls back to your ssh config / current user)"
                  },
                  "ssh_port": {
                    "type": "integer",
                    "title": "SSH Port",
                    "description": "TCP port for the SSH connection",
                    "default": 22
                  },
                  "ssh_key_path": {
                    "type": "string",
                    "title": "SSH Key File",
                    "description": "Path to a private key file for SSH authentication (optional)",
                    "ui:widget": "file-picker"
                  },
                  "ssh_host_key_policy": {
                    "type": "string",
                    "title": "SSH Host Key Policy",
                    "description": "How to treat the edge's SSH host key. 'auto' trusts whatever key the device presents and records nothing, so a reimaged device (which comes back with a new key) reconnects with no manual step. 'strict' uses your own ~/.ssh/known_hosts: an unknown or changed key is reported and the bus stops, rather than retrying.",
                    "enum": [
                      "auto",
                      "strict"
                    ],
                    "default": "auto"
                  },
                  "ssh_extra_opts": {
                    "type": "string",
                    "title": "SSH Extra Options",
                    "description": "Additional ssh command-line options, space-separated (e.g. -J bastion). Placed before the options above; ssh honours the first -o it sees, so these win over the settings above."
                  },
                  "ssh_hw_timestamps": {
                    "type": "boolean",
                    "title": "Hardware timestamps",
                    "description": "Uses the adapter's hardware clock when the edge's candump supports -H; interfaces without one (vcan, some slcan) fall back to the extension's wall clock. Turn off to use the edge kernel's receive time.",
                    "default": true,
                    "ui:widget": "toggle"
                  },
                  "fd_mode": {
                    "type": "boolean",
                    "title": "CAN-FD Mode",
                    "description": "Enable CAN-FD for higher data rates and larger payloads",
                    "default": false,
                    "ui:widget": "toggle"
                  }
                },
                "required": [
                  "interface",
                  "remote_host"
                ]
              },
              {
                "properties": {
                  "interface": {
                    "enum": [
                      "PCAN"
                    ]
                  },
                  "channel": {
                    "type": "string",
                    "title": "Channel",
                    "description": "CAN channel identifier",
                    "default": "PCAN_USBBUS1"
                  },
                  "bitrate": {
                    "type": "integer",
                    "title": "Bitrate (bps)",
                    "description": "CAN bus bitrate",
                    "enum": [
                      125000,
                      250000,
                      500000,
                      1000000
                    ],
                    "default": 500000
                  },
                  "fd_mode": {
                    "type": "boolean",
                    "title": "CAN-FD Mode",
                    "description": "Enable CAN-FD for higher data rates and larger payloads",
                    "default": false,
                    "ui:widget": "toggle"
                  },
                  "config_json": {
                    "type": "string",
                    "title": "Advanced Configuration (JSON)",
                    "description": "Additional python-can Bus() kwargs as JSON object"
                  }
                },
                "required": [
                  "channel",
                  "bitrate"
                ],
                "dependencies": {
                  "fd_mode": {
                    "oneOf": [
                      {
                        "properties": {
                          "fd_mode": {
                            "enum": [
                              false
                            ]
                          }
                        }
                      },
                      {
                        "properties": {
                          "fd_mode": {
                            "enum": [
                              true
                            ]
                          },
                          "data_bitrate": {
                            "type": "integer",
                            "title": "CAN-FD Data Bitrate (bps)",
                            "description": "CAN-FD data phase bitrate",
                            "enum": [
                              500000,
                              1000000,
                              2000000,
                              4000000,
                              8000000
                            ],
                            "default": 2000000
                          }
                        },
                        "required": [
                          "data_bitrate"
                        ]
                      }
                    ]
                  }
                }
              },
              {
                "properties": {
                  "interface": {
                    "enum": [
                      "Kvaser"
                    ]
                  },
                  "channel": {
                    "type": "string",
                    "title": "Channel",
                    "description": "CAN channel identifier",
                    "default": "0"
                  },
                  "bitrate": {
                    "type": "integer",
                    "title": "Bitrate (bps)",
                    "description": "CAN bus bitrate",
                    "enum": [
                      125000,
                      250000,
                      500000,
                      1000000
                    ],
                    "default": 500000
                  },
                  "fd_mode": {
                    "type": "boolean",
                    "title": "CAN-FD Mode",
                    "description": "Enable CAN-FD for higher data rates and larger payloads",
                    "default": false,
                    "ui:widget": "toggle"
                  },
                  "config_json": {
                    "type": "string",
                    "title": "Advanced Configuration (JSON)",
                    "description": "Additional python-can Bus() kwargs as JSON object"
                  }
                },
                "required": [
                  "channel",
                  "bitrate"
                ],
                "dependencies": {
                  "fd_mode": {
                    "oneOf": [
                      {
                        "properties": {
                          "fd_mode": {
                            "enum": [
                              false
                            ]
                          }
                        }
                      },
                      {
                        "properties": {
                          "fd_mode": {
                            "enum": [
                              true
                            ]
                          },
                          "data_bitrate": {
                            "type": "integer",
                            "title": "CAN-FD Data Bitrate (bps)",
                            "description": "CAN-FD data phase bitrate",
                            "enum": [
                              500000,
                              1000000,
                              2000000,
                              4000000,
                              8000000
                            ],
                            "default": 2000000
                          }
                        },
                        "required": [
                          "data_bitrate"
                        ]
                      }
                    ]
                  }
                }
              },
              {
                "properties": {
                  "interface": {
                    "enum": [
                      "Vector"
                    ]
                  },
                  "channel": {
                    "type": "string",
                    "title": "Channel",
                    "description": "CAN channel identifier",
                    "default": "0"
                  },
                  "bitrate": {
                    "type": "integer",
                    "title": "Bitrate (bps)",
                    "description": "CAN bus bitrate",
                    "enum": [
                      125000,
                      250000,
                      500000,
                      1000000
                    ],
                    "default": 500000
                  },
                  "fd_mode": {
                    "type": "boolean",
                    "title": "CAN-FD Mode",
                    "description": "Enable CAN-FD for higher data rates and larger payloads",
                    "default": false,
                    "ui:widget": "toggle"
                  },
                  "config_json": {
                    "type": "string",
                    "title": "Advanced Configuration (JSON)",
                    "description": "Additional python-can Bus() kwargs as JSON object"
                  }
                },
                "required": [
                  "channel",
                  "bitrate"
                ],
                "dependencies": {
                  "fd_mode": {
                    "oneOf": [
                      {
                        "properties": {
                          "fd_mode": {
                            "enum": [
                              false
                            ]
                          }
                        }
                      },
                      {
                        "properties": {
                          "fd_mode": {
                            "enum": [
                              true
                            ]
                          },
                          "data_bitrate": {
                            "type": "integer",
                            "title": "CAN-FD Data Bitrate (bps)",
                            "description": "CAN-FD data phase bitrate",
                            "enum": [
                              500000,
                              1000000,
                              2000000,
                              4000000,
                              8000000
                            ],
                            "default": 2000000
                          }
                        },
                        "required": [
                          "data_bitrate"
                        ]
                      }
                    ]
                  }
                }
              },
              {
                "properties": {
                  "interface": {
                    "enum": [
                      "slcan (serial)"
                    ]
                  },
                  "channel": {
                    "type": "string",
                    "title": "Serial Port",
                    "description": "Serial device of the slcan adapter: /dev/ttyACM0 (Linux), /dev/tty.usbmodem... (macOS), COM3 (Windows).",
                    "ui:placeholder": "/dev/ttyACM0"
                  },
                  "bitrate": {
                    "type": "integer",
                    "title": "Bitrate (bps)",
                    "description": "CAN bus bitrate",
                    "enum": [
                      10000,
                      20000,
                      50000,
                      83300,
                      100000,
                      125000,
                      250000,
                      500000,
                      750000,
                      1000000
                    ],
                    "default": 500000
                  },
                  "config_json": {
                    "type": "string",
                    "title": "Advanced Configuration (JSON)",
                    "description": "Additional python-can slcan Bus() kwargs as JSON object, e.g. {\"tty_baudrate\": 115200} for a UART adapter"
                  }
                },
                "required": [
                  "channel",
                  "bitrate"
                ]
              },
              {
                "properties": {
                  "interface": {
                    "enum": [
                      "Other (python-can)"
                    ]
                  },
                  "config_json": {
                    "type": "string",
                    "title": "Advanced Configuration (JSON)",
                    "description": "Provide complete python-can Bus() kwargs as JSON. Must include 'interface' and 'channel' keys. Example: {\"interface\": \"ixxat\", \"channel\": 0, \"bitrate\": 500000}"
                  }
                },
                "required": [
                  "config_json"
                ]
              },
              {
                "properties": {
                  "interface": {
                    "enum": [
                      "gs_usb (USB)"
                    ]
                  },
                  "channel": {
                    "type": "integer",
                    "title": "Device Index",
                    "description": "Which connected gs_usb adapter to use, in scan order (0 = first). Leave empty to use the first, or to pick the adapter by USB Bus and USB Address instead. Needs the extension's gs_usb extra. Windows: candleLight firmware binds WinUSB on its own; older or clone firmware may need Zadig. Linux: the kernel gs_usb driver claims the adapter as SocketCAN; this interface needs that driver unbound and USB access (root or a udev rule).",
                    "minimum": 0,
                    "ui:placeholder": "0"
                  },
                  "usb_bus": {
                    "type": "integer",
                    "title": "USB Bus",
                    "description": "USB bus number of the adapter, with USB Address. Instead of Device Index.",
                    "minimum": 0
                  },
                  "usb_address": {
                    "type": "integer",
                    "title": "USB Address",
                    "description": "USB device address of the adapter on USB Bus. Instead of Device Index.",
                    "minimum": 1,
                    "maximum": 127
                  },
                  "bitrate": {
                    "type": "integer",
                    "title": "Bitrate (bps)",
                    "description": "CAN bus bitrate",
                    "enum": [
                      10000,
                      20000,
                      50000,
                      83300,
                      100000,
                      125000,
                      250000,
                      500000,
                      750000,
                      1000000
                    ],
                    "default": 500000
                  },
                  "config_json": {
                    "type": "string",
                    "title": "Advanced Configuration (JSON)",
                    "description": "Additional python-can gs_usb Bus() kwargs as JSON object"
                  }
                },
                "required": [
                  "bitrate"
                ],
                "dependencies": {
                  "usb_bus": {
                    "required": [
                      "usb_address"
                    ],
                    "not": {
                      "required": [
                        "channel"
                      ]
                    }
                  },
                  "usb_address": {
                    "required": [
                      "usb_bus"
                    ],
                    "not": {
                      "required": [
                        "channel"
                      ]
                    }
                  }
                }
              }
            ]
          }
        },
        "ui:order": [
          "interface",
          "remote_host",
          "ssh_user",
          "channel",
          "remote_channel",
          "name",
          "database_files",
          "canopen_nodes",
          "*"
        ]
      },
      "default": []
    },
    "advanced": {
      "type": "object",
      "title": "Advanced",
      "description": "Settings that apply to every bus.",
      "properties": {
        "prefix": {
          "type": "string",
          "title": "Prefix",
          "description": "Leading trace source every bus publishes under, so events read '<prefix>/<bus>/<message>'. Clear it to give each bus its own trace source with unprefixed events.",
          "default": "CAN",
          "ui:placeholder": "CAN",
          "ui:emptyValue": ""
        },
        "log_raw_frames": {
          "type": "boolean",
          "title": "Log Raw CAN Frames",
          "description": "Log undecoded CAN frames to '<bus>/Frame' alongside the decoded signals.",
          "default": true,
          "ui:widget": "toggle"
        },
        "receive_own_messages": {
          "type": "boolean",
          "title": "Receive Own Messages",
          "description": "Receive messages transmitted by this host (useful for testing and monitoring).",
          "default": true,
          "ui:widget": "toggle"
        },
        "emit_schemas_on_init": {
          "type": "boolean",
          "title": "Emit Schemas On Init",
          "description": "Generate and emit all message schemas at startup (true) or lazily as messages are encountered (false).",
          "default": false,
          "ui:widget": "toggle"
        },
        "timestamp_mode": {
          "type": "string",
          "title": "Timestamp Mode",
          "description": "How to treat the timestamp the interface reports: 'auto' trusts it when it is within ~15s of local time, otherwise maps monotonic stamps onto local wall-clock; 'absolute' uses it as-is; 'ignore' uses the local receive time. For ssh-socketcan the stamp comes from the REMOTE clock, so a skewed edge NTP/RTC will shift trace timestamps.",
          "enum": [
            "auto",
            "absolute",
            "ignore"
          ],
          "default": "auto"
        },
        "j1939": {
          "type": "boolean",
          "title": "J1939",
          "description": "Every 29-bit message on a SocketCAN or SocketCAN over SSH bus is a J1939 parameter group, for a DBC that does not mark them (VFrameFormat). Off, the messages the DBC marks J1939 still are: matched by PGN from any sender, one table per sender, transport protocol transfers (BAM, RTS/CTS) rebuilt, reserved raw values (not available, error) decoded to empty.",
          "default": false,
          "ui:widget": "toggle"
        },
        "j1939_node": {
          "type": "string",
          "title": "J1939 Node",
          "description": "The DBC node (BU_) every SocketCAN and SocketCAN over SSH bus acts as on J1939: it claims the node's address (NmStationAddress) for its NAME (the NmJ1939* node attributes) when the bus starts, and the J1939 send actions send from it. The node must be in each such bus's DBCs. Empty: no claim until the J1939 Claim action, and J1939 sends refuse.",
          "default": "",
          "ui:placeholder": "Tester"
        },
        "canopen": {
          "type": "boolean",
          "title": "CANopen",
          "description": "Decode CANopen (NMT, heartbeat, EMCY, SYNC, TIME, SDO) for every node-id on a SocketCAN or SocketCAN over SSH bus, for a bus with no CANopen nodes configured. Off, a bus decodes CANopen only when it lists nodes.",
          "default": false,
          "ui:widget": "toggle"
        },
        "log_level": {
          "type": "string",
          "title": "Log Level",
          "description": "Set the logging verbosity level for all buses.",
          "enum": [
            "DEBUG",
            "INFO",
            "WARNING",
            "ERROR",
            "CRITICAL"
          ],
          "default": "INFO"
        }
      },
      "additionalProperties": false,
      "default": {},
      "ui:options": {
        "collapsed": true
      }
    }
  },
  "required": [
    "buses"
  ]
}
