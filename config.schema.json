    "advanced": {
      "type": "object",
      "title": "Advanced",
      "description": "Settings that apply to every bus.",
      "properties": {
        "prefix": {
          "type": "string",
          "title": "Prefix",
          "description": "Leading trace source every bus publishes under, so events read '<prefix>/<bus>/<message>'. Clear it to give each bus its own trace source with unprefixed events.",
          "default": "CAN",
          "ui:placeholder": "CAN"
        },
        "log_raw_frames": {
          "type": "boolean",
          "title": "Log Raw CAN Frames",
          "description": "Log undecoded CAN frames to '<bus>/Frame' alongside the decoded signals.",
          "default": true,
          "ui:widget": "toggle"
        },
        "receive_own_messages": {
          "type": "boolean",
          "title": "Receive Own Messages",
          "description": "Receive messages transmitted by this host (useful for testing and monitoring).",
          "default": true,
          "ui:widget": "toggle"
        },
        "emit_schemas_on_init": {
          "type": "boolean",
          "title": "Emit Schemas On Init",
          "description": "Generate and emit all message schemas at startup (true) or lazily as messages are encountered (false).",
          "default": false,
          "ui:widget": "toggle"
        },
        "timestamp_mode": {
          "type": "string",
          "title": "Timestamp Mode",
          "description": "How to treat the timestamp the interface reports: 'auto' trusts it when it is within ~15s of local time, otherwise maps monotonic stamps onto local wall-clock; 'absolute' uses it as-is; 'ignore' uses the local receive time. For ssh-socketcan the stamp comes from the REMOTE clock, so a skewed edge NTP/RTC will shift trace timestamps.",
          "enum": [
            "auto",
            "absolute",
            "ignore"
          ],
          "default": "auto"
        },
        "log_level": {
          "type": "string",
          "title": "Log Level",
          "description": "Set the logging verbosity level for all buses.",
          "enum": [
            "DEBUG",
            "INFO",
            "WARNING",
            "ERROR",
            "CRITICAL"
          ],
          "default": "INFO"
        }
      },
      "additionalProperties": false,
      "default": {},
      "ui:options": {
        "collapsed": true
      }
    }
