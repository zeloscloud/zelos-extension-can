        "properties": {
          "interface": {
            "type": "string",
            "title": "Interface",
            "description": "CAN interface type. zelos-socketcan is the Rust-backed SocketCAN interface (Linux only); socketcan is the python-can implementation. macOS/Windows: pcan/kvaser/vector. ssh-socketcan works from any OS, bridging a remote SocketCAN interface over SSH using the edge's own can-utils (candump/cansend); nothing is deployed on the edge and TX is always echoed back by the remote kernel loopback.",
            "enum": [
              "zelos-socketcan",
              "ssh-socketcan",
              "demo",
              "virtual",
              "socketcan",
              "pcan",
              "kvaser",
              "vector",
              "other"
            ]
          }
        },
