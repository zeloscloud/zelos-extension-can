                        <I-PDU-PORT-REF DEST="I-PDU-PORT">/Ecus/Tester/Tester_CanConnector/PP_DcdcSecured_IN</I-PDU-PORT-REF>
                      </I-PDU-PORT-REFS>
                      <I-PDU-REF DEST="SECURED-I-PDU">/Pdus/DcdcSecured</I-PDU-REF>
                    </PDU-TRIGGERING>
                    <PDU-TRIGGERING>
                      <SHORT-NAME>PT_UdsRequestSdu</SHORT-NAME>
                      <I-PDU-PORT-REFS>
