<?xml version="1.0" encoding="UTF-8"?>
<!--
  can-full: the zelos-examples CAN bench as an AUTOSAR R19-11 System Template.

  The source of the DC-DC's AUTOSAR PDUs: tools/arxml2c.py generates
  nodes/dcdc/src/autosar_pdus.{c,h} from it (`just arxml`), and CI fails when
  they and this file disagree. Frames from dbc/bench.dbc appear unchanged.
-->
<AUTOSAR xmlns="http://autosar.org/schema/r4.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_00048.xsd">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>Units</SHORT-NAME>
      <ELEMENTS>
        <UNIT>
          <SHORT-NAME>Percent</SHORT-NAME>
          <DISPLAY-NAME>%</DISPLAY-NAME>
        </UNIT>
        <UNIT>
          <SHORT-NAME>A</SHORT-NAME>
          <DISPLAY-NAME>A</DISPLAY-NAME>
        </UNIT>
        <UNIT>
          <SHORT-NAME>Nm</SHORT-NAME>
          <DISPLAY-NAME>Nm</DISPLAY-NAME>
        </UNIT>
        <UNIT>
          <SHORT-NAME>V</SHORT-NAME>
          <DISPLAY-NAME>V</DISPLAY-NAME>
        </UNIT>
        <UNIT>
          <SHORT-NAME>W</SHORT-NAME>
          <DISPLAY-NAME>W</DISPLAY-NAME>
        </UNIT>
        <UNIT>
          <SHORT-NAME>degC</SHORT-NAME>
          <DISPLAY-NAME>degC</DISPLAY-NAME>
        </UNIT>
        <UNIT>
          <SHORT-NAME>s</SHORT-NAME>
          <DISPLAY-NAME>s</DISPLAY-NAME>
        </UNIT>
      </ELEMENTS>
    </AR-PACKAGE>
    <AR-PACKAGE>
      <SHORT-NAME>Transformers</SHORT-NAME>
      <ELEMENTS>
        <DATA-TRANSFORMATION-SET>
          <SHORT-NAME>E2E</SHORT-NAME>
          <DATA-TRANSFORMATIONS>
            <DATA-TRANSFORMATION>
              <SHORT-NAME>DcdcOutputP1_Chain</SHORT-NAME>
              <DATA-TRANSFORMATION-KIND>SYMMETRIC</DATA-TRANSFORMATION-KIND>
              <EXECUTE-DESPITE-DATA-UNAVAILABILITY>true</EXECUTE-DESPITE-DATA-UNAVAILABILITY>
              <TRANSFORMER-CHAIN-REFS>
                <TRANSFORMER-CHAIN-REF DEST="TRANSFORMATION-TECHNOLOGY">/Transformers/E2E/ComBased</TRANSFORMER-CHAIN-REF>
                <TRANSFORMER-CHAIN-REF DEST="TRANSFORMATION-TECHNOLOGY">/Transformers/E2E/DcdcOutputP1_E2E</TRANSFORMER-CHAIN-REF>
              </TRANSFORMER-CHAIN-REFS>
            </DATA-TRANSFORMATION>
            <DATA-TRANSFORMATION>
              <SHORT-NAME>DcdcThermalP2_Chain</SHORT-NAME>
              <DATA-TRANSFORMATION-KIND>SYMMETRIC</DATA-TRANSFORMATION-KIND>
              <EXECUTE-DESPITE-DATA-UNAVAILABILITY>true</EXECUTE-DESPITE-DATA-UNAVAILABILITY>
              <TRANSFORMER-CHAIN-REFS>
                <TRANSFORMER-CHAIN-REF DEST="TRANSFORMATION-TECHNOLOGY">/Transformers/E2E/ComBased</TRANSFORMER-CHAIN-REF>
                <TRANSFORMER-CHAIN-REF DEST="TRANSFORMATION-TECHNOLOGY">/Transformers/E2E/DcdcThermalP2_E2E</TRANSFORMER-CHAIN-REF>
              </TRANSFORMER-CHAIN-REFS>
            </DATA-TRANSFORMATION>
            <DATA-TRANSFORMATION>
              <SHORT-NAME>DcdcPowerP5_Chain</SHORT-NAME>
              <DATA-TRANSFORMATION-KIND>SYMMETRIC</DATA-TRANSFORMATION-KIND>
              <EXECUTE-DESPITE-DATA-UNAVAILABILITY>true</EXECUTE-DESPITE-DATA-UNAVAILABILITY>
              <TRANSFORMER-CHAIN-REFS>
                <TRANSFORMER-CHAIN-REF DEST="TRANSFORMATION-TECHNOLOGY">/Transformers/E2E/ComBased</TRANSFORMER-CHAIN-REF>
                <TRANSFORMER-CHAIN-REF DEST="TRANSFORMATION-TECHNOLOGY">/Transformers/E2E/DcdcPowerP5_E2E</TRANSFORMER-CHAIN-REF>
              </TRANSFORMER-CHAIN-REFS>
            </DATA-TRANSFORMATION>
          </DATA-TRANSFORMATIONS>
          <TRANSFORMATION-TECHNOLOGYS>
            <TRANSFORMATION-TECHNOLOGY>
              <SHORT-NAME>ComBased</SHORT-NAME>
              <BUFFER-PROPERTIES>
                <HEADER-LENGTH>0</HEADER-LENGTH>
                <IN-PLACE>true</IN-PLACE>
              </BUFFER-PROPERTIES>
              <PROTOCOL>COMBased</PROTOCOL>
              <TRANSFORMER-CLASS>SERIALIZER</TRANSFORMER-CLASS>
              <VERSION>1.0.0</VERSION>
            </TRANSFORMATION-TECHNOLOGY>
            <TRANSFORMATION-TECHNOLOGY>
              <SHORT-NAME>DcdcOutputP1_E2E</SHORT-NAME>
              <BUFFER-PROPERTIES>
                <HEADER-LENGTH>0</HEADER-LENGTH>
                <IN-PLACE>true</IN-PLACE>
              </BUFFER-PROPERTIES>
              <NEEDS-ORIGINAL-DATA>false</NEEDS-ORIGINAL-DATA>
              <PROTOCOL>E2E</PROTOCOL>
              <TRANSFORMATION-DESCRIPTIONS>
                <END-TO-END-TRANSFORMATION-DESCRIPTION>
                  <COUNTER-OFFSET>8</COUNTER-OFFSET>
                  <CRC-OFFSET>0</CRC-OFFSET>
                  <DATA-ID-MODE>ALL-16-BIT</DATA-ID-MODE>
                  <MAX-DELTA-COUNTER>1</MAX-DELTA-COUNTER>
                  <MAX-NO-NEW-OR-REPEATED-DATA>15</MAX-NO-NEW-OR-REPEATED-DATA>
                  <PROFILE-NAME>PROFILE_01</PROFILE-NAME>
                  <SYNC-COUNTER-INIT>0</SYNC-COUNTER-INIT>
                </END-TO-END-TRANSFORMATION-DESCRIPTION>
              </TRANSFORMATION-DESCRIPTIONS>
              <TRANSFORMER-CLASS>SAFETY</TRANSFORMER-CLASS>
              <VERSION>1.0.0</VERSION>
            </TRANSFORMATION-TECHNOLOGY>
            <TRANSFORMATION-TECHNOLOGY>
              <SHORT-NAME>DcdcThermalP2_E2E</SHORT-NAME>
              <BUFFER-PROPERTIES>
                <HEADER-LENGTH>0</HEADER-LENGTH>
                <IN-PLACE>true</IN-PLACE>
              </BUFFER-PROPERTIES>
              <NEEDS-ORIGINAL-DATA>false</NEEDS-ORIGINAL-DATA>
              <PROTOCOL>E2E</PROTOCOL>
              <TRANSFORMATION-DESCRIPTIONS>
                <END-TO-END-TRANSFORMATION-DESCRIPTION>
                  <MAX-DELTA-COUNTER>1</MAX-DELTA-COUNTER>
                  <MAX-NO-NEW-OR-REPEATED-DATA>15</MAX-NO-NEW-OR-REPEATED-DATA>
                  <OFFSET>0</OFFSET>
                  <PROFILE-NAME>PROFILE_02</PROFILE-NAME>
                  <SYNC-COUNTER-INIT>0</SYNC-COUNTER-INIT>
                </END-TO-END-TRANSFORMATION-DESCRIPTION>
              </TRANSFORMATION-DESCRIPTIONS>
              <TRANSFORMER-CLASS>SAFETY</TRANSFORMER-CLASS>
              <VERSION>1.0.0</VERSION>
            </TRANSFORMATION-TECHNOLOGY>
            <TRANSFORMATION-TECHNOLOGY>
              <SHORT-NAME>DcdcPowerP5_E2E</SHORT-NAME>
              <BUFFER-PROPERTIES>
                <HEADER-LENGTH>0</HEADER-LENGTH>
                <IN-PLACE>true</IN-PLACE>
              </BUFFER-PROPERTIES>
              <NEEDS-ORIGINAL-DATA>false</NEEDS-ORIGINAL-DATA>
              <PROTOCOL>E2E</PROTOCOL>
              <TRANSFORMATION-DESCRIPTIONS>
                <END-TO-END-TRANSFORMATION-DESCRIPTION>
                  <MAX-DELTA-COUNTER>1</MAX-DELTA-COUNTER>
                  <OFFSET>0</OFFSET>
                  <PROFILE-NAME>PROFILE_05</PROFILE-NAME>
                </END-TO-END-TRANSFORMATION-DESCRIPTION>
              </TRANSFORMATION-DESCRIPTIONS>
              <TRANSFORMER-CLASS>SAFETY</TRANSFORMER-CLASS>
              <VERSION>1.0.0</VERSION>
            </TRANSFORMATION-TECHNOLOGY>
          </TRANSFORMATION-TECHNOLOGYS>
        </DATA-TRANSFORMATION-SET>
      </ELEMENTS>
    </AR-PACKAGE>
    <AR-PACKAGE>
      <SHORT-NAME>SecOC</SHORT-NAME>
      <ELEMENTS>
        <SECURE-COMMUNICATION-PROPS-SET>
          <SHORT-NAME>Profile1</SHORT-NAME>
          <AUTHENTICATION-PROPSS>
            <SECURE-COMMUNICATION-AUTHENTICATION-PROPS>
              <SHORT-NAME>Aes128Cmac24</SHORT-NAME>
              <AUTH-ALGORITHM>CMAC/AES-128</AUTH-ALGORITHM>
              <AUTH-INFO-TX-LENGTH>24</AUTH-INFO-TX-LENGTH>
            </SECURE-COMMUNICATION-AUTHENTICATION-PROPS>
          </AUTHENTICATION-PROPSS>
          <FRESHNESS-PROPSS>
            <SECURE-COMMUNICATION-FRESHNESS-PROPS>
              <SHORT-NAME>FreshnessCounter8</SHORT-NAME>
              <FRESHNESS-VALUE-LENGTH>8</FRESHNESS-VALUE-LENGTH>
              <FRESHNESS-VALUE-TX-LENGTH>8</FRESHNESS-VALUE-TX-LENGTH>
            </SECURE-COMMUNICATION-FRESHNESS-PROPS>
          </FRESHNESS-PROPSS>
        </SECURE-COMMUNICATION-PROPS-SET>
      </ELEMENTS>
    </AR-PACKAGE>
    <AR-PACKAGE>
      <SHORT-NAME>Pdus</SHORT-NAME>
      <ELEMENTS>
        <I-SIGNAL-I-PDU>
          <SHORT-NAME>VCU_Command</SHORT-NAME>
          <DESC>
            <L-2 L="EN">Operating mode request and heartbeat. The BMS and DC-DC both follow the commanded mode.</L-2>
          </DESC>
          <LENGTH>4</LENGTH>
          <I-PDU-TIMING-SPECIFICATIONS>
            <I-PDU-TIMING>
              <TRANSMISSION-MODE-DECLARATION>
                <TRANSMISSION-MODE-TRUE-TIMING>
                  <CYCLIC-TIMING>
                    <TIME-PERIOD>
                      <VALUE>0.1</VALUE>
                    </TIME-PERIOD>
                  </CYCLIC-TIMING>
                </TRANSMISSION-MODE-TRUE-TIMING>
              </TRANSMISSION-MODE-DECLARATION>
            </I-PDU-TIMING>
          </I-PDU-TIMING-SPECIFICATIONS>
          <I-SIGNAL-TO-PDU-MAPPINGS>
            <I-SIGNAL-TO-I-PDU-MAPPING>
              <SHORT-NAME>RequestedMode</SHORT-NAME>
              <I-SIGNAL-REF DEST="I-SIGNAL">/Signals/VCU_Command/RequestedMode</I-SIGNAL-REF>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <START-POSITION>0</START-POSITION>
              <TRANSFER-PROPERTY>PENDING</TRANSFER-PROPERTY>
            </I-SIGNAL-TO-I-PDU-MAPPING>
            <I-SIGNAL-TO-I-PDU-MAPPING>
              <SHORT-NAME>TorqueRequest</SHORT-NAME>
              <I-SIGNAL-REF DEST="I-SIGNAL">/Signals/VCU_Command/TorqueRequest</I-SIGNAL-REF>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <START-POSITION>8</START-POSITION>
              <TRANSFER-PROPERTY>PENDING</TRANSFER-PROPERTY>
            </I-SIGNAL-TO-I-PDU-MAPPING>
            <I-SIGNAL-TO-I-PDU-MAPPING>
              <SHORT-NAME>Heartbeat</SHORT-NAME>
              <I-SIGNAL-REF DEST="I-SIGNAL">/Signals/VCU_Command/Heartbeat</I-SIGNAL-REF>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <START-POSITION>24</START-POSITION>
              <TRANSFER-PROPERTY>PENDING</TRANSFER-PROPERTY>
            </I-SIGNAL-TO-I-PDU-MAPPING>
          </I-SIGNAL-TO-PDU-MAPPINGS>
          <UNUSED-BIT-PATTERN>0</UNUSED-BIT-PATTERN>
        </I-SIGNAL-I-PDU>
        <I-SIGNAL-I-PDU>
          <SHORT-NAME>BMS_Status</SHORT-NAME>
          <DESC>
            <L-2 L="EN">Pack-level measurements and contactor state.</L-2>
          </DESC>
          <LENGTH>7</LENGTH>
          <I-PDU-TIMING-SPECIFICATIONS>
            <I-PDU-TIMING>
              <TRANSMISSION-MODE-DECLARATION>
                <TRANSMISSION-MODE-TRUE-TIMING>
                  <CYCLIC-TIMING>
                    <TIME-PERIOD>
                      <VALUE>0.1</VALUE>
                    </TIME-PERIOD>
                  </CYCLIC-TIMING>
                </TRANSMISSION-MODE-TRUE-TIMING>
              </TRANSMISSION-MODE-DECLARATION>
            </I-PDU-TIMING>
          </I-PDU-TIMING-SPECIFICATIONS>
          <I-SIGNAL-TO-PDU-MAPPINGS>
            <I-SIGNAL-TO-I-PDU-MAPPING>
              <SHORT-NAME>PackVoltage</SHORT-NAME>
              <I-SIGNAL-REF DEST="I-SIGNAL">/Signals/BMS_Status/PackVoltage</I-SIGNAL-REF>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <START-POSITION>0</START-POSITION>
              <TRANSFER-PROPERTY>PENDING</TRANSFER-PROPERTY>
            </I-SIGNAL-TO-I-PDU-MAPPING>
            <I-SIGNAL-TO-I-PDU-MAPPING>
              <SHORT-NAME>PackCurrent</SHORT-NAME>
              <I-SIGNAL-REF DEST="I-SIGNAL">/Signals/BMS_Status/PackCurrent</I-SIGNAL-REF>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <START-POSITION>16</START-POSITION>
              <TRANSFER-PROPERTY>PENDING</TRANSFER-PROPERTY>
            </I-SIGNAL-TO-I-PDU-MAPPING>
            <I-SIGNAL-TO-I-PDU-MAPPING>
              <SHORT-NAME>StateOfCharge</SHORT-NAME>
              <I-SIGNAL-REF DEST="I-SIGNAL">/Signals/BMS_Status/StateOfCharge</I-SIGNAL-REF>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <START-POSITION>32</START-POSITION>
              <TRANSFER-PROPERTY>PENDING</TRANSFER-PROPERTY>
            </I-SIGNAL-TO-I-PDU-MAPPING>
            <I-SIGNAL-TO-I-PDU-MAPPING>
              <SHORT-NAME>ContactorState</SHORT-NAME>
              <I-SIGNAL-REF DEST="I-SIGNAL">/Signals/BMS_Status/ContactorState</I-SIGNAL-REF>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <START-POSITION>40</START-POSITION>
              <TRANSFER-PROPERTY>PENDING</TRANSFER-PROPERTY>
            </I-SIGNAL-TO-I-PDU-MAPPING>
            <I-SIGNAL-TO-I-PDU-MAPPING>
              <SHORT-NAME>Counter</SHORT-NAME>
              <I-SIGNAL-REF DEST="I-SIGNAL">/Signals/BMS_Status/Counter</I-SIGNAL-REF>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <START-POSITION>48</START-POSITION>
              <TRANSFER-PROPERTY>PENDING</TRANSFER-PROPERTY>
            </I-SIGNAL-TO-I-PDU-MAPPING>
          </I-SIGNAL-TO-PDU-MAPPINGS>
          <UNUSED-BIT-PATTERN>0</UNUSED-BIT-PATTERN>
        </I-SIGNAL-I-PDU>
        <I-SIGNAL-I-PDU>
          <SHORT-NAME>BMS_Limits</SHORT-NAME>
          <DESC>
            <L-2 L="EN">The current envelope the pack allows right now. AuxCurrentLimit bounds what the DC-DC may draw from the pack.</L-2>
          </DESC>
          <LENGTH>7</LENGTH>
          <I-PDU-TIMING-SPECIFICATIONS>
            <I-PDU-TIMING>
              <TRANSMISSION-MODE-DECLARATION>
                <TRANSMISSION-MODE-TRUE-TIMING>
                  <CYCLIC-TIMING>
                    <TIME-PERIOD>
                      <VALUE>0.1</VALUE>
                    </TIME-PERIOD>
                  </CYCLIC-TIMING>
                </TRANSMISSION-MODE-TRUE-TIMING>
              </TRANSMISSION-MODE-DECLARATION>
            </I-PDU-TIMING>
          </I-PDU-TIMING-SPECIFICATIONS>
          <I-SIGNAL-TO-PDU-MAPPINGS>
            <I-SIGNAL-TO-I-PDU-MAPPING>
              <SHORT-NAME>DischargeCurrentLimit</SHORT-NAME>
              <I-SIGNAL-REF DEST="I-SIGNAL">/Signals/BMS_Limits/DischargeCurrentLimit</I-SIGNAL-REF>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <START-POSITION>0</START-POSITION>
              <TRANSFER-PROPERTY>PENDING</TRANSFER-PROPERTY>
            </I-SIGNAL-TO-I-PDU-MAPPING>
            <I-SIGNAL-TO-I-PDU-MAPPING>
              <SHORT-NAME>ChargeCurrentLimit</SHORT-NAME>
              <I-SIGNAL-REF DEST="I-SIGNAL">/Signals/BMS_Limits/ChargeCurrentLimit</I-SIGNAL-REF>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <START-POSITION>16</START-POSITION>
              <TRANSFER-PROPERTY>PENDING</TRANSFER-PROPERTY>
            </I-SIGNAL-TO-I-PDU-MAPPING>
            <I-SIGNAL-TO-I-PDU-MAPPING>
              <SHORT-NAME>AuxCurrentLimit</SHORT-NAME>
              <I-SIGNAL-REF DEST="I-SIGNAL">/Signals/BMS_Limits/AuxCurrentLimit</I-SIGNAL-REF>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <START-POSITION>32</START-POSITION>
              <TRANSFER-PROPERTY>PENDING</TRANSFER-PROPERTY>
            </I-SIGNAL-TO-I-PDU-MAPPING>
            <I-SIGNAL-TO-I-PDU-MAPPING>
              <SHORT-NAME>Counter</SHORT-NAME>
              <I-SIGNAL-REF DEST="I-SIGNAL">/Signals/BMS_Limits/Counter</I-SIGNAL-REF>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <START-POSITION>48</START-POSITION>
              <TRANSFER-PROPERTY>PENDING</TRANSFER-PROPERTY>
            </I-SIGNAL-TO-I-PDU-MAPPING>
          </I-SIGNAL-TO-PDU-MAPPINGS>
          <UNUSED-BIT-PATTERN>0</UNUSED-BIT-PATTERN>
        </I-SIGNAL-I-PDU>
        <I-SIGNAL-I-PDU>
          <SHORT-NAME>BMS_CellVoltages</SHORT-NAME>
          <DESC>
            <L-2 L="EN">Per-cell voltages. Four cells, one frame, no multiplexing.</L-2>
          </DESC>
          <LENGTH>7</LENGTH>
          <I-PDU-TIMING-SPECIFICATIONS>
            <I-PDU-TIMING>
              <TRANSMISSION-MODE-DECLARATION>
                <TRANSMISSION-MODE-TRUE-TIMING>
                  <CYCLIC-TIMING>
                    <TIME-PERIOD>
                      <VALUE>0.5</VALUE>
                    </TIME-PERIOD>
                  </CYCLIC-TIMING>
                </TRANSMISSION-MODE-TRUE-TIMING>
              </TRANSMISSION-MODE-DECLARATION>
            </I-PDU-TIMING>
          </I-PDU-TIMING-SPECIFICATIONS>
          <I-SIGNAL-TO-PDU-MAPPINGS>
            <I-SIGNAL-TO-I-PDU-MAPPING>
              <SHORT-NAME>CellVoltage1</SHORT-NAME>
              <I-SIGNAL-REF DEST="I-SIGNAL">/Signals/BMS_CellVoltages/CellVoltage1</I-SIGNAL-REF>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <START-POSITION>0</START-POSITION>
              <TRANSFER-PROPERTY>PENDING</TRANSFER-PROPERTY>
            </I-SIGNAL-TO-I-PDU-MAPPING>
            <I-SIGNAL-TO-I-PDU-MAPPING>
              <SHORT-NAME>CellVoltage2</SHORT-NAME>
              <I-SIGNAL-REF DEST="I-SIGNAL">/Signals/BMS_CellVoltages/CellVoltage2</I-SIGNAL-REF>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <START-POSITION>12</START-POSITION>
              <TRANSFER-PROPERTY>PENDING</TRANSFER-PROPERTY>
            </I-SIGNAL-TO-I-PDU-MAPPING>
            <I-SIGNAL-TO-I-PDU-MAPPING>
              <SHORT-NAME>CellVoltage3</SHORT-NAME>
              <I-SIGNAL-REF DEST="I-SIGNAL">/Signals/BMS_CellVoltages/CellVoltage3</I-SIGNAL-REF>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <START-POSITION>24</START-POSITION>
              <TRANSFER-PROPERTY>PENDING</TRANSFER-PROPERTY>
            </I-SIGNAL-TO-I-PDU-MAPPING>
            <I-SIGNAL-TO-I-PDU-MAPPING>
              <SHORT-NAME>CellVoltage4</SHORT-NAME>
              <I-SIGNAL-REF DEST="I-SIGNAL">/Signals/BMS_CellVoltages/CellVoltage4</I-SIGNAL-REF>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <START-POSITION>36</START-POSITION>
              <TRANSFER-PROPERTY>PENDING</TRANSFER-PROPERTY>
            </I-SIGNAL-TO-I-PDU-MAPPING>
            <I-SIGNAL-TO-I-PDU-MAPPING>
              <SHORT-NAME>Counter</SHORT-NAME>
              <I-SIGNAL-REF DEST="I-SIGNAL">/Signals/BMS_CellVoltages/Counter</I-SIGNAL-REF>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <START-POSITION>48</START-POSITION>
              <TRANSFER-PROPERTY>PENDING</TRANSFER-PROPERTY>
            </I-SIGNAL-TO-I-PDU-MAPPING>
          </I-SIGNAL-TO-PDU-MAPPINGS>
          <UNUSED-BIT-PATTERN>0</UNUSED-BIT-PATTERN>
        </I-SIGNAL-I-PDU>
        <I-SIGNAL-I-PDU>
          <SHORT-NAME>DCDC_Status</SHORT-NAME>
          <DESC>
            <L-2 L="EN">DC-DC converter state. InputCurrent is drawn from the pack and must stay within BMS_Limits.AuxCurrentLimit.</L-2>
          </DESC>
          <LENGTH>8</LENGTH>
          <I-PDU-TIMING-SPECIFICATIONS>
            <I-PDU-TIMING>
              <TRANSMISSION-MODE-DECLARATION>
                <TRANSMISSION-MODE-TRUE-TIMING>
                  <CYCLIC-TIMING>
                    <TIME-PERIOD>
                      <VALUE>0.05</VALUE>
                    </TIME-PERIOD>
                  </CYCLIC-TIMING>
                </TRANSMISSION-MODE-TRUE-TIMING>
              </TRANSMISSION-MODE-DECLARATION>
            </I-PDU-TIMING>
          </I-PDU-TIMING-SPECIFICATIONS>
          <I-SIGNAL-TO-PDU-MAPPINGS>
            <I-SIGNAL-TO-I-PDU-MAPPING>
              <SHORT-NAME>OutputVoltage</SHORT-NAME>
              <I-SIGNAL-REF DEST="I-SIGNAL">/Signals/DCDC_Status/OutputVoltage</I-SIGNAL-REF>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <START-POSITION>0</START-POSITION>
              <TRANSFER-PROPERTY>PENDING</TRANSFER-PROPERTY>
            </I-SIGNAL-TO-I-PDU-MAPPING>
            <I-SIGNAL-TO-I-PDU-MAPPING>
              <SHORT-NAME>OutputCurrent</SHORT-NAME>
              <I-SIGNAL-REF DEST="I-SIGNAL">/Signals/DCDC_Status/OutputCurrent</I-SIGNAL-REF>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <START-POSITION>16</START-POSITION>
              <TRANSFER-PROPERTY>PENDING</TRANSFER-PROPERTY>
            </I-SIGNAL-TO-I-PDU-MAPPING>
            <I-SIGNAL-TO-I-PDU-MAPPING>
              <SHORT-NAME>InputCurrent</SHORT-NAME>
              <I-SIGNAL-REF DEST="I-SIGNAL">/Signals/DCDC_Status/InputCurrent</I-SIGNAL-REF>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <START-POSITION>32</START-POSITION>
              <TRANSFER-PROPERTY>PENDING</TRANSFER-PROPERTY>
            </I-SIGNAL-TO-I-PDU-MAPPING>
            <I-SIGNAL-TO-I-PDU-MAPPING>
              <SHORT-NAME>Temperature</SHORT-NAME>
              <I-SIGNAL-REF DEST="I-SIGNAL">/Signals/DCDC_Status/Temperature</I-SIGNAL-REF>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <START-POSITION>48</START-POSITION>
              <TRANSFER-PROPERTY>PENDING</TRANSFER-PROPERTY>
            </I-SIGNAL-TO-I-PDU-MAPPING>
            <I-SIGNAL-TO-I-PDU-MAPPING>
              <SHORT-NAME>DerateActive</SHORT-NAME>
              <I-SIGNAL-REF DEST="I-SIGNAL">/Signals/DCDC_Status/DerateActive</I-SIGNAL-REF>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <START-POSITION>56</START-POSITION>
              <TRANSFER-PROPERTY>PENDING</TRANSFER-PROPERTY>
            </I-SIGNAL-TO-I-PDU-MAPPING>
