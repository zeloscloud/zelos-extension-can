    <AR-PACKAGE>
      <SHORT-NAME>Frames</SHORT-NAME>
      <ELEMENTS>
        <CAN-FRAME>
          <SHORT-NAME>VCU_Command</SHORT-NAME>
          <DESC>
            <L-2 L="EN">Operating mode request and heartbeat. The BMS and DC-DC both follow the commanded mode.</L-2>
          </DESC>
          <FRAME-LENGTH>4</FRAME-LENGTH>
          <PDU-TO-FRAME-MAPPINGS>
            <PDU-TO-FRAME-MAPPING>
              <SHORT-NAME>VCU_Command</SHORT-NAME>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <PDU-REF DEST="I-SIGNAL-I-PDU">/Pdus/VCU_Command</PDU-REF>
              <START-POSITION>0</START-POSITION>
            </PDU-TO-FRAME-MAPPING>
          </PDU-TO-FRAME-MAPPINGS>
        </CAN-FRAME>
        <CAN-FRAME>
          <SHORT-NAME>BMS_Status</SHORT-NAME>
          <DESC>
            <L-2 L="EN">Pack-level measurements and contactor state.</L-2>
          </DESC>
          <FRAME-LENGTH>7</FRAME-LENGTH>
          <PDU-TO-FRAME-MAPPINGS>
            <PDU-TO-FRAME-MAPPING>
              <SHORT-NAME>BMS_Status</SHORT-NAME>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <PDU-REF DEST="I-SIGNAL-I-PDU">/Pdus/BMS_Status</PDU-REF>
              <START-POSITION>0</START-POSITION>
            </PDU-TO-FRAME-MAPPING>
          </PDU-TO-FRAME-MAPPINGS>
        </CAN-FRAME>
        <CAN-FRAME>
          <SHORT-NAME>BMS_Limits</SHORT-NAME>
          <DESC>
            <L-2 L="EN">The current envelope the pack allows right now. AuxCurrentLimit bounds what the DC-DC may draw from the pack.</L-2>
          </DESC>
          <FRAME-LENGTH>7</FRAME-LENGTH>
          <PDU-TO-FRAME-MAPPINGS>
            <PDU-TO-FRAME-MAPPING>
              <SHORT-NAME>BMS_Limits</SHORT-NAME>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <PDU-REF DEST="I-SIGNAL-I-PDU">/Pdus/BMS_Limits</PDU-REF>
              <START-POSITION>0</START-POSITION>
            </PDU-TO-FRAME-MAPPING>
          </PDU-TO-FRAME-MAPPINGS>
        </CAN-FRAME>
        <CAN-FRAME>
          <SHORT-NAME>BMS_CellVoltages</SHORT-NAME>
          <DESC>
            <L-2 L="EN">Per-cell voltages. Four cells, one frame, no multiplexing.</L-2>
          </DESC>
          <FRAME-LENGTH>7</FRAME-LENGTH>
          <PDU-TO-FRAME-MAPPINGS>
            <PDU-TO-FRAME-MAPPING>
              <SHORT-NAME>BMS_CellVoltages</SHORT-NAME>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <PDU-REF DEST="I-SIGNAL-I-PDU">/Pdus/BMS_CellVoltages</PDU-REF>
              <START-POSITION>0</START-POSITION>
            </PDU-TO-FRAME-MAPPING>
          </PDU-TO-FRAME-MAPPINGS>
        </CAN-FRAME>
        <CAN-FRAME>
          <SHORT-NAME>DCDC_Status</SHORT-NAME>
          <DESC>
            <L-2 L="EN">DC-DC converter state. InputCurrent is drawn from the pack and must stay within BMS_Limits.AuxCurrentLimit.</L-2>
          </DESC>
          <FRAME-LENGTH>8</FRAME-LENGTH>
          <PDU-TO-FRAME-MAPPINGS>
            <PDU-TO-FRAME-MAPPING>
              <SHORT-NAME>DCDC_Status</SHORT-NAME>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <PDU-REF DEST="I-SIGNAL-I-PDU">/Pdus/DCDC_Status</PDU-REF>
              <START-POSITION>0</START-POSITION>
            </PDU-TO-FRAME-MAPPING>
          </PDU-TO-FRAME-MAPPINGS>
        </CAN-FRAME>
        <CAN-FRAME>
          <SHORT-NAME>DcdcOutputP1</SHORT-NAME>
          <DESC>
            <L-2 L="EN">Rail output and pack current, E2E profile 1.</L-2>
          </DESC>
          <FRAME-LENGTH>8</FRAME-LENGTH>
          <PDU-TO-FRAME-MAPPINGS>
            <PDU-TO-FRAME-MAPPING>
              <SHORT-NAME>DcdcOutputP1</SHORT-NAME>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <PDU-REF DEST="I-SIGNAL-I-PDU">/Pdus/DcdcOutputP1</PDU-REF>
              <START-POSITION>0</START-POSITION>
            </PDU-TO-FRAME-MAPPING>
          </PDU-TO-FRAME-MAPPINGS>
        </CAN-FRAME>
        <CAN-FRAME>
          <SHORT-NAME>DcdcThermalP2</SHORT-NAME>
          <DESC>
            <L-2 L="EN">Thermal state and the pack allowance, E2E profile 2.</L-2>
          </DESC>
          <FRAME-LENGTH>8</FRAME-LENGTH>
          <PDU-TO-FRAME-MAPPINGS>
            <PDU-TO-FRAME-MAPPING>
              <SHORT-NAME>DcdcThermalP2</SHORT-NAME>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <PDU-REF DEST="I-SIGNAL-I-PDU">/Pdus/DcdcThermalP2</PDU-REF>
              <START-POSITION>0</START-POSITION>
            </PDU-TO-FRAME-MAPPING>
          </PDU-TO-FRAME-MAPPINGS>
        </CAN-FRAME>
        <CAN-FRAME>
          <SHORT-NAME>DcdcPowerP5</SHORT-NAME>
          <DESC>
            <L-2 L="EN">Power, pack voltage and setpoint, E2E profile 5.</L-2>
          </DESC>
          <FRAME-LENGTH>8</FRAME-LENGTH>
          <PDU-TO-FRAME-MAPPINGS>
            <PDU-TO-FRAME-MAPPING>
              <SHORT-NAME>DcdcPowerP5</SHORT-NAME>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <PDU-REF DEST="I-SIGNAL-I-PDU">/Pdus/DcdcPowerP5</PDU-REF>
              <START-POSITION>0</START-POSITION>
            </PDU-TO-FRAME-MAPPING>
          </PDU-TO-FRAME-MAPPINGS>
        </CAN-FRAME>
        <CAN-FRAME>
          <SHORT-NAME>DcdcContainer</SHORT-NAME>
          <DESC>
            <L-2 L="EN">Dynamic container, short headers: one contained PDU per frame.</L-2>
          </DESC>
          <FRAME-LENGTH>8</FRAME-LENGTH>
          <PDU-TO-FRAME-MAPPINGS>
            <PDU-TO-FRAME-MAPPING>
              <SHORT-NAME>DcdcContainer</SHORT-NAME>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <PDU-REF DEST="CONTAINER-I-PDU">/Pdus/DcdcContainer</PDU-REF>
              <START-POSITION>0</START-POSITION>
            </PDU-TO-FRAME-MAPPING>
          </PDU-TO-FRAME-MAPPINGS>
        </CAN-FRAME>
        <CAN-FRAME>
          <SHORT-NAME>DcdcMux</SHORT-NAME>
          <DESC>
            <L-2 L="EN">Multiplexed: state and voltage always, currents and limits in turn.</L-2>
          </DESC>
          <FRAME-LENGTH>8</FRAME-LENGTH>
          <PDU-TO-FRAME-MAPPINGS>
            <PDU-TO-FRAME-MAPPING>
              <SHORT-NAME>DcdcMux</SHORT-NAME>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <PDU-REF DEST="MULTIPLEXED-I-PDU">/Pdus/DcdcMux</PDU-REF>
              <START-POSITION>0</START-POSITION>
            </PDU-TO-FRAME-MAPPING>
          </PDU-TO-FRAME-MAPPINGS>
        </CAN-FRAME>
        <CAN-FRAME>
          <SHORT-NAME>DcdcSecured</SHORT-NAME>
          <DESC>
            <L-2 L="EN">SecOC profile 1 (24Bit-CMAC-8Bit-FV): payload, 8-bit freshness, 24-bit AES-128 CMAC.</L-2>
          </DESC>
          <FRAME-LENGTH>8</FRAME-LENGTH>
          <PDU-TO-FRAME-MAPPINGS>
            <PDU-TO-FRAME-MAPPING>
              <SHORT-NAME>DcdcSecured</SHORT-NAME>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <PDU-REF DEST="SECURED-I-PDU">/Pdus/DcdcSecured</PDU-REF>
              <START-POSITION>0</START-POSITION>
            </PDU-TO-FRAME-MAPPING>
          </PDU-TO-FRAME-MAPPINGS>
        </CAN-FRAME>
        <CAN-FRAME>
          <SHORT-NAME>UdsRequest</SHORT-NAME>
          <DESC>
            <L-2 L="EN">ISO-TP frames of physical requests, and the tester's flow control.</L-2>
          </DESC>
          <FRAME-LENGTH>8</FRAME-LENGTH>
          <PDU-TO-FRAME-MAPPINGS>
            <PDU-TO-FRAME-MAPPING>
              <SHORT-NAME>UdsRequest</SHORT-NAME>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <PDU-REF DEST="N-PDU">/Pdus/UdsRequest</PDU-REF>
              <START-POSITION>0</START-POSITION>
            </PDU-TO-FRAME-MAPPING>
          </PDU-TO-FRAME-MAPPINGS>
        </CAN-FRAME>
        <CAN-FRAME>
          <SHORT-NAME>UdsFunctionalRequest</SHORT-NAME>
          <DESC>
            <L-2 L="EN">ISO-TP single frames of functional requests.</L-2>
          </DESC>
          <FRAME-LENGTH>8</FRAME-LENGTH>
          <PDU-TO-FRAME-MAPPINGS>
            <PDU-TO-FRAME-MAPPING>
              <SHORT-NAME>UdsFunctionalRequest</SHORT-NAME>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <PDU-REF DEST="N-PDU">/Pdus/UdsFunctionalRequest</PDU-REF>
              <START-POSITION>0</START-POSITION>
            </PDU-TO-FRAME-MAPPING>
          </PDU-TO-FRAME-MAPPINGS>
        </CAN-FRAME>
        <CAN-FRAME>
          <SHORT-NAME>UdsResponse</SHORT-NAME>
          <DESC>
            <L-2 L="EN">ISO-TP frames of responses, and the DC-DC's flow control.</L-2>
          </DESC>
          <FRAME-LENGTH>8</FRAME-LENGTH>
          <PDU-TO-FRAME-MAPPINGS>
            <PDU-TO-FRAME-MAPPING>
              <SHORT-NAME>UdsResponse</SHORT-NAME>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <PDU-REF DEST="N-PDU">/Pdus/UdsResponse</PDU-REF>
              <START-POSITION>0</START-POSITION>
            </PDU-TO-FRAME-MAPPING>
          </PDU-TO-FRAME-MAPPINGS>
        </CAN-FRAME>
        <CAN-FRAME>
          <SHORT-NAME>XcpCro</SHORT-NAME>
          <DESC>
            <L-2 L="EN">XCP master to slave.</L-2>
          </DESC>
          <FRAME-LENGTH>8</FRAME-LENGTH>
          <PDU-TO-FRAME-MAPPINGS>
            <PDU-TO-FRAME-MAPPING>
              <SHORT-NAME>XcpCro</SHORT-NAME>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <PDU-REF DEST="GENERAL-PURPOSE-I-PDU">/Pdus/XcpCro</PDU-REF>
              <START-POSITION>0</START-POSITION>
            </PDU-TO-FRAME-MAPPING>
          </PDU-TO-FRAME-MAPPINGS>
        </CAN-FRAME>
        <CAN-FRAME>
          <SHORT-NAME>XcpDto</SHORT-NAME>
          <DESC>
            <L-2 L="EN">XCP slave to master: responses, events, DAQ.</L-2>
          </DESC>
          <FRAME-LENGTH>8</FRAME-LENGTH>
          <PDU-TO-FRAME-MAPPINGS>
            <PDU-TO-FRAME-MAPPING>
              <SHORT-NAME>XcpDto</SHORT-NAME>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <PDU-REF DEST="GENERAL-PURPOSE-I-PDU">/Pdus/XcpDto</PDU-REF>
              <START-POSITION>0</START-POSITION>
            </PDU-TO-FRAME-MAPPING>
          </PDU-TO-FRAME-MAPPINGS>
        </CAN-FRAME>
      </ELEMENTS>
    </AR-PACKAGE>
    <AR-PACKAGE>
      <SHORT-NAME>PduGroups</SHORT-NAME>
      <ELEMENTS>
        <I-SIGNAL-I-PDU-GROUP>
          <SHORT-NAME>BMS_Rx</SHORT-NAME>
          <COMMUNICATION-DIRECTION>IN</COMMUNICATION-DIRECTION>
          <I-SIGNAL-I-PDUS>
            <I-SIGNAL-I-PDU-REF-CONDITIONAL>
              <I-SIGNAL-I-PDU-REF DEST="I-SIGNAL-I-PDU">/Pdus/VCU_Command</I-SIGNAL-I-PDU-REF>
            </I-SIGNAL-I-PDU-REF-CONDITIONAL>
            <I-SIGNAL-I-PDU-REF-CONDITIONAL>
              <I-SIGNAL-I-PDU-REF DEST="I-SIGNAL-I-PDU">/Pdus/DCDC_Status</I-SIGNAL-I-PDU-REF>
            </I-SIGNAL-I-PDU-REF-CONDITIONAL>
          </I-SIGNAL-I-PDUS>
        </I-SIGNAL-I-PDU-GROUP>
        <I-SIGNAL-I-PDU-GROUP>
          <SHORT-NAME>BMS_Tx</SHORT-NAME>
          <COMMUNICATION-DIRECTION>OUT</COMMUNICATION-DIRECTION>
          <I-SIGNAL-I-PDUS>
            <I-SIGNAL-I-PDU-REF-CONDITIONAL>
              <I-SIGNAL-I-PDU-REF DEST="I-SIGNAL-I-PDU">/Pdus/BMS_Status</I-SIGNAL-I-PDU-REF>
            </I-SIGNAL-I-PDU-REF-CONDITIONAL>
            <I-SIGNAL-I-PDU-REF-CONDITIONAL>
              <I-SIGNAL-I-PDU-REF DEST="I-SIGNAL-I-PDU">/Pdus/BMS_Limits</I-SIGNAL-I-PDU-REF>
            </I-SIGNAL-I-PDU-REF-CONDITIONAL>
            <I-SIGNAL-I-PDU-REF-CONDITIONAL>
              <I-SIGNAL-I-PDU-REF DEST="I-SIGNAL-I-PDU">/Pdus/BMS_CellVoltages</I-SIGNAL-I-PDU-REF>
            </I-SIGNAL-I-PDU-REF-CONDITIONAL>
          </I-SIGNAL-I-PDUS>
        </I-SIGNAL-I-PDU-GROUP>
        <I-SIGNAL-I-PDU-GROUP>
          <SHORT-NAME>DCDC_Rx</SHORT-NAME>
          <COMMUNICATION-DIRECTION>IN</COMMUNICATION-DIRECTION>
          <I-SIGNAL-I-PDUS>
            <I-SIGNAL-I-PDU-REF-CONDITIONAL>
              <I-SIGNAL-I-PDU-REF DEST="I-SIGNAL-I-PDU">/Pdus/VCU_Command</I-SIGNAL-I-PDU-REF>
            </I-SIGNAL-I-PDU-REF-CONDITIONAL>
            <I-SIGNAL-I-PDU-REF-CONDITIONAL>
              <I-SIGNAL-I-PDU-REF DEST="I-SIGNAL-I-PDU">/Pdus/BMS_Status</I-SIGNAL-I-PDU-REF>
            </I-SIGNAL-I-PDU-REF-CONDITIONAL>
            <I-SIGNAL-I-PDU-REF-CONDITIONAL>
              <I-SIGNAL-I-PDU-REF DEST="I-SIGNAL-I-PDU">/Pdus/BMS_Limits</I-SIGNAL-I-PDU-REF>
            </I-SIGNAL-I-PDU-REF-CONDITIONAL>
