                        <I-PDU-PORT-REF DEST="I-PDU-PORT">/Ecus/Tester/Tester_CanConnector/PP_UdsFunctionalRequest_OUT</I-PDU-PORT-REF>
                      </I-PDU-PORT-REFS>
                      <I-PDU-REF DEST="N-PDU">/Pdus/UdsFunctionalRequest</I-PDU-REF>
