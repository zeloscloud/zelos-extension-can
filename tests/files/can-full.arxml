        </CAN-CLUSTER>
      </ELEMENTS>
    </AR-PACKAGE>
    <AR-PACKAGE>
      <SHORT-NAME>CanTp</SHORT-NAME>
      <ELEMENTS>
        <CAN-TP-CONFIG>
          <SHORT-NAME>CanFullCanTp</SHORT-NAME>
          <DESC>
            <L-2 L="EN">ISO 15765-2 normal addressing, as the DC-DC's UDS server runs it: block size 0, STmin 0, frames padded to 8 bytes (0xCC), N_As/N_Ar/N_Bs/N_Cr 1 s, half duplex.</L-2>
          </DESC>
          <COMMUNICATION-CLUSTER-REF DEST="CAN-CLUSTER">/Communication/CanFull</COMMUNICATION-CLUSTER-REF>
          <TP-CHANNELS>
            <CAN-TP-CHANNEL>
              <SHORT-NAME>UdsChannel</SHORT-NAME>
              <CHANNEL-ID>0</CHANNEL-ID>
              <CHANNEL-MODE>HALF-DUPLEX-MODE</CHANNEL-MODE>
            </CAN-TP-CHANNEL>
          </TP-CHANNELS>
          <TP-CONNECTIONS>
            <CAN-TP-CONNECTION>
              <IDENT>
                <SHORT-NAME>UdsPhysical</SHORT-NAME>
              </IDENT>
              <ADDRESSING-FORMAT>STANDARD</ADDRESSING-FORMAT>
              <CAN-TP-CHANNEL-REF DEST="CAN-TP-CHANNEL">/CanTp/CanFullCanTp/UdsChannel</CAN-TP-CHANNEL-REF>
              <DATA-PDU-REF DEST="N-PDU">/Pdus/UdsRequest</DATA-PDU-REF>
              <FLOW-CONTROL-PDU-REF DEST="N-PDU">/Pdus/UdsResponse</FLOW-CONTROL-PDU-REF>
              <MAX-BLOCK-SIZE>0</MAX-BLOCK-SIZE>
              <PADDING-ACTIVATION>true</PADDING-ACTIVATION>
              <RECEIVER-REFS>
                <RECEIVER-REF DEST="CAN-TP-NODE">/CanTp/CanFullCanTp/DCDC_TpNode</RECEIVER-REF>
              </RECEIVER-REFS>
              <TA-TYPE>PHYSICAL</TA-TYPE>
              <TIMEOUT-BS>1</TIMEOUT-BS>
              <TIMEOUT-CR>1</TIMEOUT-CR>
              <TP-SDU-REF DEST="DCM-I-PDU">/Pdus/UdsRequestSdu</TP-SDU-REF>
              <TRANSMITTER-REF DEST="CAN-TP-NODE">/CanTp/CanFullCanTp/Tester_TpNode</TRANSMITTER-REF>
            </CAN-TP-CONNECTION>
            <CAN-TP-CONNECTION>
              <IDENT>
                <SHORT-NAME>UdsFunctional</SHORT-NAME>
              </IDENT>
              <ADDRESSING-FORMAT>STANDARD</ADDRESSING-FORMAT>
              <CAN-TP-CHANNEL-REF DEST="CAN-TP-CHANNEL">/CanTp/CanFullCanTp/UdsChannel</CAN-TP-CHANNEL-REF>
              <DATA-PDU-REF DEST="N-PDU">/Pdus/UdsFunctionalRequest</DATA-PDU-REF>
              <MAX-BLOCK-SIZE>0</MAX-BLOCK-SIZE>
              <PADDING-ACTIVATION>true</PADDING-ACTIVATION>
              <RECEIVER-REFS>
                <RECEIVER-REF DEST="CAN-TP-NODE">/CanTp/CanFullCanTp/DCDC_TpNode</RECEIVER-REF>
              </RECEIVER-REFS>
              <TA-TYPE>FUNCTIONAL</TA-TYPE>
              <TP-SDU-REF DEST="DCM-I-PDU">/Pdus/UdsFunctionalRequestSdu</TP-SDU-REF>
              <TRANSMITTER-REF DEST="CAN-TP-NODE">/CanTp/CanFullCanTp/Tester_TpNode</TRANSMITTER-REF>
            </CAN-TP-CONNECTION>
            <CAN-TP-CONNECTION>
              <IDENT>
                <SHORT-NAME>UdsResponse</SHORT-NAME>
              </IDENT>
              <ADDRESSING-FORMAT>STANDARD</ADDRESSING-FORMAT>
              <CAN-TP-CHANNEL-REF DEST="CAN-TP-CHANNEL">/CanTp/CanFullCanTp/UdsChannel</CAN-TP-CHANNEL-REF>
              <DATA-PDU-REF DEST="N-PDU">/Pdus/UdsResponse</DATA-PDU-REF>
              <FLOW-CONTROL-PDU-REF DEST="N-PDU">/Pdus/UdsRequest</FLOW-CONTROL-PDU-REF>
              <MAX-BLOCK-SIZE>0</MAX-BLOCK-SIZE>
              <PADDING-ACTIVATION>true</PADDING-ACTIVATION>
              <RECEIVER-REFS>
                <RECEIVER-REF DEST="CAN-TP-NODE">/CanTp/CanFullCanTp/Tester_TpNode</RECEIVER-REF>
              </RECEIVER-REFS>
              <TA-TYPE>PHYSICAL</TA-TYPE>
              <TIMEOUT-BS>1</TIMEOUT-BS>
              <TIMEOUT-CR>1</TIMEOUT-CR>
              <TP-SDU-REF DEST="DCM-I-PDU">/Pdus/UdsResponseSdu</TP-SDU-REF>
              <TRANSMITTER-REF DEST="CAN-TP-NODE">/CanTp/CanFullCanTp/DCDC_TpNode</TRANSMITTER-REF>
            </CAN-TP-CONNECTION>
          </TP-CONNECTIONS>
          <TP-ECUS>
            <CAN-TP-ECU>
              <ECU-INSTANCE-REF DEST="ECU-INSTANCE">/Ecus/DCDC</ECU-INSTANCE-REF>
            </CAN-TP-ECU>
            <CAN-TP-ECU>
              <ECU-INSTANCE-REF DEST="ECU-INSTANCE">/Ecus/Tester</ECU-INSTANCE-REF>
            </CAN-TP-ECU>
          </TP-ECUS>
          <TP-NODES>
            <CAN-TP-NODE>
              <SHORT-NAME>DCDC_TpNode</SHORT-NAME>
              <CONNECTOR-REF DEST="CAN-COMMUNICATION-CONNECTOR">/Ecus/DCDC/DCDC_CanConnector</CONNECTOR-REF>
              <MAX-FC-WAIT>0</MAX-FC-WAIT>
              <ST-MIN>0</ST-MIN>
              <TIMEOUT-AR>1</TIMEOUT-AR>
              <TIMEOUT-AS>1</TIMEOUT-AS>
            </CAN-TP-NODE>
            <CAN-TP-NODE>
              <SHORT-NAME>Tester_TpNode</SHORT-NAME>
              <CONNECTOR-REF DEST="CAN-COMMUNICATION-CONNECTOR">/Ecus/Tester/Tester_CanConnector</CONNECTOR-REF>
              <MAX-FC-WAIT>0</MAX-FC-WAIT>
              <ST-MIN>0</ST-MIN>
              <TIMEOUT-AR>1</TIMEOUT-AR>
              <TIMEOUT-AS>1</TIMEOUT-AS>
            </CAN-TP-NODE>
          </TP-NODES>
        </CAN-TP-CONFIG>
      </ELEMENTS>
    </AR-PACKAGE>
    <AR-PACKAGE>
      <SHORT-NAME>System</SHORT-NAME>
      <ELEMENTS>
        <SYSTEM>
          <SHORT-NAME>CanFull</SHORT-NAME>
          <DESC>
            <L-2 L="EN">The zelos-examples can-full bench: the VCU and BMS nodes and the DC-DC of the combined image (nodes/full). bench.dbc plus the DC-DC's AUTOSAR PDUs, UDS and XCP. J1939 (genset.dbc) and CANopen (nodes/pdu/od/pdu.eds) on the same bus are described in their own files.</L-2>
          </DESC>
          <CATEGORY>SYSTEM_DESCRIPTION</CATEGORY>
          <CONTAINER-I-PDU-HEADER-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-FIRST</CONTAINER-I-PDU-HEADER-BYTE-ORDER>
          <FIBEX-ELEMENTS>
            <FIBEX-ELEMENT-REF-CONDITIONAL>
              <FIBEX-ELEMENT-REF DEST="CAN-CLUSTER">/Communication/CanFull</FIBEX-ELEMENT-REF>
            </FIBEX-ELEMENT-REF-CONDITIONAL>
            <FIBEX-ELEMENT-REF-CONDITIONAL>
              <FIBEX-ELEMENT-REF DEST="I-SIGNAL-I-PDU">/Pdus/VCU_Command</FIBEX-ELEMENT-REF>
            </FIBEX-ELEMENT-REF-CONDITIONAL>
            <FIBEX-ELEMENT-REF-CONDITIONAL>
              <FIBEX-ELEMENT-REF DEST="I-SIGNAL">/Signals/VCU_Command/RequestedMode</FIBEX-ELEMENT-REF>
            </FIBEX-ELEMENT-REF-CONDITIONAL>
            <FIBEX-ELEMENT-REF-CONDITIONAL>
              <FIBEX-ELEMENT-REF DEST="I-SIGNAL">/Signals/VCU_Command/TorqueRequest</FIBEX-ELEMENT-REF>
            </FIBEX-ELEMENT-REF-CONDITIONAL>
            <FIBEX-ELEMENT-REF-CONDITIONAL>
              <FIBEX-ELEMENT-REF DEST="I-SIGNAL">/Signals/VCU_Command/Heartbeat</FIBEX-ELEMENT-REF>
            </FIBEX-ELEMENT-REF-CONDITIONAL>
            <FIBEX-ELEMENT-REF-CONDITIONAL>
              <FIBEX-ELEMENT-REF DEST="I-SIGNAL-I-PDU">/Pdus/BMS_Status</FIBEX-ELEMENT-REF>
            </FIBEX-ELEMENT-REF-CONDITIONAL>
            <FIBEX-ELEMENT-REF-CONDITIONAL>
              <FIBEX-ELEMENT-REF DEST="I-SIGNAL">/Signals/BMS_Status/PackVoltage</FIBEX-ELEMENT-REF>
            </FIBEX-ELEMENT-REF-CONDITIONAL>
            <FIBEX-ELEMENT-REF-CONDITIONAL>
              <FIBEX-ELEMENT-REF DEST="I-SIGNAL">/Signals/BMS_Status/PackCurrent</FIBEX-ELEMENT-REF>
            </FIBEX-ELEMENT-REF-CONDITIONAL>
            <FIBEX-ELEMENT-REF-CONDITIONAL>
              <FIBEX-ELEMENT-REF DEST="I-SIGNAL">/Signals/BMS_Status/StateOfCharge</FIBEX-ELEMENT-REF>
            </FIBEX-ELEMENT-REF-CONDITIONAL>
            <FIBEX-ELEMENT-REF-CONDITIONAL>
              <FIBEX-ELEMENT-REF DEST="I-SIGNAL">/Signals/BMS_Status/ContactorState</FIBEX-ELEMENT-REF>
            </FIBEX-ELEMENT-REF-CONDITIONAL>
            <FIBEX-ELEMENT-REF-CONDITIONAL>
              <FIBEX-ELEMENT-REF DEST="I-SIGNAL">/Signals/BMS_Status/Counter</FIBEX-ELEMENT-REF>
            </FIBEX-ELEMENT-REF-CONDITIONAL>
            <FIBEX-ELEMENT-REF-CONDITIONAL>
              <FIBEX-ELEMENT-REF DEST="I-SIGNAL-I-PDU">/Pdus/BMS_Limits</FIBEX-ELEMENT-REF>
            </FIBEX-ELEMENT-REF-CONDITIONAL>
            <FIBEX-ELEMENT-REF-CONDITIONAL>
              <FIBEX-ELEMENT-REF DEST="I-SIGNAL">/Signals/BMS_Limits/DischargeCurrentLimit</FIBEX-ELEMENT-REF>
            </FIBEX-ELEMENT-REF-CONDITIONAL>
            <FIBEX-ELEMENT-REF-CONDITIONAL>
              <FIBEX-ELEMENT-REF DEST="I-SIGNAL">/Signals/BMS_Limits/ChargeCurrentLimit</FIBEX-ELEMENT-REF>
            </FIBEX-ELEMENT-REF-CONDITIONAL>
            <FIBEX-ELEMENT-REF-CONDITIONAL>
              <FIBEX-ELEMENT-REF DEST="I-SIGNAL">/Signals/BMS_Limits/AuxCurrentLimit</FIBEX-ELEMENT-REF>
            </FIBEX-ELEMENT-REF-CONDITIONAL>
            <FIBEX-ELEMENT-REF-CONDITIONAL>
              <FIBEX-ELEMENT-REF DEST="I-SIGNAL">/Signals/BMS_Limits/Counter</FIBEX-ELEMENT-REF>
            </FIBEX-ELEMENT-REF-CONDITIONAL>
            <FIBEX-ELEMENT-REF-CONDITIONAL>
              <FIBEX-ELEMENT-REF DEST="I-SIGNAL-I-PDU">/Pdus/BMS_CellVoltages</FIBEX-ELEMENT-REF>
            </FIBEX-ELEMENT-REF-CONDITIONAL>
            <FIBEX-ELEMENT-REF-CONDITIONAL>
              <FIBEX-ELEMENT-REF DEST="I-SIGNAL">/Signals/BMS_CellVoltages/CellVoltage1</FIBEX-ELEMENT-REF>
            </FIBEX-ELEMENT-REF-CONDITIONAL>
            <FIBEX-ELEMENT-REF-CONDITIONAL>
              <FIBEX-ELEMENT-REF DEST="I-SIGNAL">/Signals/BMS_CellVoltages/CellVoltage2</FIBEX-ELEMENT-REF>
            </FIBEX-ELEMENT-REF-CONDITIONAL>
            <FIBEX-ELEMENT-REF-CONDITIONAL>
              <FIBEX-ELEMENT-REF DEST="I-SIGNAL">/Signals/BMS_CellVoltages/CellVoltage3</FIBEX-ELEMENT-REF>
            </FIBEX-ELEMENT-REF-CONDITIONAL>
            <FIBEX-ELEMENT-REF-CONDITIONAL>
              <FIBEX-ELEMENT-REF DEST="I-SIGNAL">/Signals/BMS_CellVoltages/CellVoltage4</FIBEX-ELEMENT-REF>
            </FIBEX-ELEMENT-REF-CONDITIONAL>
            <FIBEX-ELEMENT-REF-CONDITIONAL>
              <FIBEX-ELEMENT-REF DEST="I-SIGNAL">/Signals/BMS_CellVoltages/Counter</FIBEX-ELEMENT-REF>
            </FIBEX-ELEMENT-REF-CONDITIONAL>
            <FIBEX-ELEMENT-REF-CONDITIONAL>
              <FIBEX-ELEMENT-REF DEST="I-SIGNAL-I-PDU">/Pdus/DCDC_Status</FIBEX-ELEMENT-REF>
            </FIBEX-ELEMENT-REF-CONDITIONAL>
            <FIBEX-ELEMENT-REF-CONDITIONAL>
              <FIBEX-ELEMENT-REF DEST="I-SIGNAL">/Signals/DCDC_Status/OutputVoltage</FIBEX-ELEMENT-REF>
            </FIBEX-ELEMENT-REF-CONDITIONAL>
            <FIBEX-ELEMENT-REF-CONDITIONAL>
              <FIBEX-ELEMENT-REF DEST="I-SIGNAL">/Signals/DCDC_Status/OutputCurrent</FIBEX-ELEMENT-REF>
            </FIBEX-ELEMENT-REF-CONDITIONAL>
            <FIBEX-ELEMENT-REF-CONDITIONAL>
              <FIBEX-ELEMENT-REF DEST="I-SIGNAL">/Signals/DCDC_Status/InputCurrent</FIBEX-ELEMENT-REF>
            </FIBEX-ELEMENT-REF-CONDITIONAL>
            <FIBEX-ELEMENT-REF-CONDITIONAL>
              <FIBEX-ELEMENT-REF DEST="I-SIGNAL">/Signals/DCDC_Status/Temperature</FIBEX-ELEMENT-REF>
            </FIBEX-ELEMENT-REF-CONDITIONAL>
            <FIBEX-ELEMENT-REF-CONDITIONAL>
              <FIBEX-ELEMENT-REF DEST="I-SIGNAL">/Signals/DCDC_Status/DerateActive</FIBEX-ELEMENT-REF>
            </FIBEX-ELEMENT-REF-CONDITIONAL>
            <FIBEX-ELEMENT-REF-CONDITIONAL>
              <FIBEX-ELEMENT-REF DEST="I-SIGNAL">/Signals/DCDC_Status/Counter</FIBEX-ELEMENT-REF>
            </FIBEX-ELEMENT-REF-CONDITIONAL>
            <FIBEX-ELEMENT-REF-CONDITIONAL>
              <FIBEX-ELEMENT-REF DEST="I-SIGNAL-I-PDU">/Pdus/DcdcOutputP1</FIBEX-ELEMENT-REF>
            </FIBEX-ELEMENT-REF-CONDITIONAL>
            <FIBEX-ELEMENT-REF-CONDITIONAL>
              <FIBEX-ELEMENT-REF DEST="I-SIGNAL">/Signals/DcdcOutputP1/CRC</FIBEX-ELEMENT-REF>
            </FIBEX-ELEMENT-REF-CONDITIONAL>
            <FIBEX-ELEMENT-REF-CONDITIONAL>
              <FIBEX-ELEMENT-REF DEST="I-SIGNAL">/Signals/DcdcOutputP1/Counter</FIBEX-ELEMENT-REF>
            </FIBEX-ELEMENT-REF-CONDITIONAL>
            <FIBEX-ELEMENT-REF-CONDITIONAL>
              <FIBEX-ELEMENT-REF DEST="I-SIGNAL">/Signals/DcdcOutputP1/DcdcState</FIBEX-ELEMENT-REF>
            </FIBEX-ELEMENT-REF-CONDITIONAL>
            <FIBEX-ELEMENT-REF-CONDITIONAL>
              <FIBEX-ELEMENT-REF DEST="I-SIGNAL">/Signals/DcdcOutputP1/OutputVoltage</FIBEX-ELEMENT-REF>
            </FIBEX-ELEMENT-REF-CONDITIONAL>
            <FIBEX-ELEMENT-REF-CONDITIONAL>
              <FIBEX-ELEMENT-REF DEST="I-SIGNAL">/Signals/DcdcOutputP1/OutputCurrent</FIBEX-ELEMENT-REF>
            </FIBEX-ELEMENT-REF-CONDITIONAL>
            <FIBEX-ELEMENT-REF-CONDITIONAL>
              <FIBEX-ELEMENT-REF DEST="I-SIGNAL">/Signals/DcdcOutputP1/InputCurrent</FIBEX-ELEMENT-REF>
