                        <I-PDU-PORT-REF DEST="I-PDU-PORT">/Ecus/Tester/Tester_CanConnector/PP_UdsRequestSdu_OUT</I-PDU-PORT-REF>
                      </I-PDU-PORT-REFS>
                      <I-PDU-REF DEST="DCM-I-PDU">/Pdus/UdsRequestSdu</I-PDU-REF>
                    </PDU-TRIGGERING>
                    <PDU-TRIGGERING>
                      <SHORT-NAME>PT_UdsFunctionalRequestSdu</SHORT-NAME>
                      <I-PDU-PORT-REFS>
                        <I-PDU-PORT-REF DEST="I-PDU-PORT">/Ecus/DCDC/DCDC_CanConnector/PP_UdsFunctionalRequestSdu_IN</I-PDU-PORT-REF>
                        <I-PDU-PORT-REF DEST="I-PDU-PORT">/Ecus/Tester/Tester_CanConnector/PP_UdsFunctionalRequestSdu_OUT</I-PDU-PORT-REF>
